# Copy to .env and replace all example values before deployment.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-before-deployment
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_TIME_ZONE=Asia/Dushanbe
POSTGRES_DB=education_crm
POSTGRES_USER=education_crm
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
APP_PORT=80
